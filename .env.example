# Mapbox — address autocomplete (Central Florida quote form)
# Get a public access token at https://account.mapbox.com/access-tokens/
# Required for the AddressInput component to suggest addresses.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_token_here

# Google Maps — embedded route map + Places (New) autocomplete on /quote.
# Enable "Maps Embed API" + "Places API (New)", restrict the key by HTTP referrer.
# Without it the map falls back to a placeholder and autocomplete to a plain input.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Maps — SERVER-side key for driving distance in lead notifications.
# Separate key: enable "Routes API", NO referrer restriction (server calls have
# none), restrict it to Routes API only. Optional — distance is skipped without it.
GOOGLE_MAPS_SERVER_KEY=

# OpenPhone / Quo — ONLY automated client SMS: quote-received confirmation.
# OPENPHONE_FROM_NUMBER must be the sending number in E.164 (NOT the ID).
OPENPHONE_API_KEY=
OPENPHONE_FROM_NUMBER=+16896002720
# Optional aliases (same as OpenPhone):
# QUO_API_KEY=
# QUO_FROM_NUMBER=+16896002720

# HMAC secret used to sign the phone-verification challenge + pass cookies.
# Generate one with: openssl rand -hex 32
VERIFY_SIGNING_SECRET=

# Resend — optional emails (checklist PDF delivery, etc.)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@toromovers.net
BOOKING_NOTIFICATION_EMAIL=

# --- Meta Ads tracking ---
NEXT_PUBLIC_META_PIXEL_ID=
META_ACCESS_TOKEN=
NEXT_PUBLIC_GA4_ID=

# --- Team alerts (each lead) — Telegram only ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Primary site URL (OG / CAPI / SMS+email links). Canonical: toromovers.com
NEXT_PUBLIC_SITE_URL=https://toromovers.com

# Shared secret for internal lead intake tools only (not HubSpot/n8n)
LEAD_INTAKE_SECRET=

# Square webhooks → auto SMS/email on deposit
# Dashboard: https://developer.squareup.com → Webhooks
# Notification URL: https://toromovers.com/api/webhooks/square
# Events: payment.updated, booking.created (optional)
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=https://toromovers.com/api/webhooks/square
# Optional — resolve customer phone/email when only customer_id is on the payment
SQUARE_ACCESS_TOKEN=
# Optional override for Google review write link
# GOOGLE_REVIEW_URL=https://g.page/r/CYAKurQHh5TvEAI/review

# ────────────────────────────────────────────────────────────
# REMOVED — do not re-add until a full redesign:
#   HUBSPOT_TOKEN, HUBSPOT_HAS_FUNNEL_TYPE, HUBSPOT_SYNC
#   N8N_*, FOLLOWUP_AUTOMATION, N8N_ENABLED
# Lead path: Telegram alert + one Quo "quote received" SMS only.
